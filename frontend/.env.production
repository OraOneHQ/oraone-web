# Production build config for oraone.in.
# Consumed by Create React App / CRACO at `npm run build` (NODE_ENV=production).
# Auth is self-hosted (Argon2 + JWT + email OTP) — no OAuth/Cognito config needed.

REACT_APP_ENV=production

# Backend API (separate subdomain)
REACT_APP_API_URL=https://api.oraone.in
