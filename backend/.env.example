# OraOne backend — environment variable template.
# Copy to `.env` and fill in real values. Never commit `.env` (gitignored).
# See docs/ENVIRONMENT.md for the full reference and docs/ARCHITECTURE.md for
# how each of these is used.

ENVIRONMENT=development

# ---- MongoDB (legacy `agents` / `leads` collections) ----
MONGO_URL=mongodb://localhost:27017/?serverSelectionTimeoutMS=3000&connectTimeoutMS=3000
DB_NAME=oraone

# ---- AWS (required by app/core/config.py at import time — Cognito) ----
# NOTE: authentication currently depends on a live Cognito user pool. If you
# don't have one, set LOCAL_AUTH_ENABLED below and these can stay as
# placeholders — the server boots fine, only real Cognito login is disabled.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---- Cognito (required) ----
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# ---- Local-dev auth bypass (optional) ----
# Enables POST /api/auth/login for ONE configured account using a
# locally-signed JWT instead of Cognito. Use only when Cognito is
# unavailable. NEVER enable in production.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_SECRET=
LOCAL_ADMIN_EMAIL=admin@oraone.in
LOCAL_ADMIN_PASSWORD=

# ---- DynamoDB (user directory, alongside Cognito) ----
DYNAMODB_USERS_TABLE=oraone-users
DYNAMODB_TABLE_NAME=oraone-users

JWT_ALGORITHM=RS256
JWT_LEEWAY_SECONDS=60

# ---- CORS — comma-separated exact origins; never `*` with credentials ----
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL (required — system of record; needs the pgvector extension) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME_PG=oraone

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/oraone
ALEMBIC_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/oraone

# ---- Redis (optional — falls back to in-process cache when unset) ----
REDIS_URL=
ENTITLEMENTS_CACHE_BACKEND=inprocess

# ---- Object storage (optional — falls back to local disk under UPLOAD_DIR) ----
# Works with real AWS S3 (leave S3_ENDPOINT_URL unset) or any S3-compatible
# store — MinIO, Cloudflare R2, Backblaze B2 — by setting S3_ENDPOINT_URL.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=/tmp/oraone-uploads

# ---- Super Admin Control Center — comma-separated founder/admin emails ----
PLATFORM_ADMIN_EMAILS=

# ---- Frontend base (used for OAuth redirects back into the app) ----
FRONTEND_URL=http://localhost:3000

# ---- Google OAuth (optional — Google Drive integration) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# ---- AI chat provider (optional — falls back to a mock/extractive responder) ----
# OraOne's OpenAIProvider reads OPENAI_* ; point OPENAI_BASE_URL at OpenRouter
# (or leave unset to use OpenAI directly). OPENROUTER_* are kept for reference/
# other tooling — the app itself only reads the OPENAI_* variables below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.5
# Pin every agent to one model regardless of its configured model name
AI_FORCE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://oraone.ai
OPENROUTER_APP_NAME=OraOne

# ---- Embeddings (optional — RAG / document + website-crawl ingestion) ----
# EMBEDDING_PROVIDER=hash needs no credentials (lexical-overlap vectors) and
# is a safe default. Switch to "bedrock" only once you have a working AWS
# Bedrock key with Titan model access — an invalid key fails ingestion loudly.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=1024
BEDROCK_REGION=ap-southeast-2
AWS_BEARER_TOKEN_BEDROCK=

# ---- Twilio (optional — WhatsApp/SMS channel, app/services/channels/) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Billing (optional — Stripe; falls back to mock mode when unset) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (optional — falls back to log-only when EMAIL_FROM is unset) ----
EMAIL_FROM=
SES_REGION=
