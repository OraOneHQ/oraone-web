flowchart TD
    Push["Git push to main"] --> CI["CI workflow (ci.yml)"]
    CI --> Lint["Lint"]
    CI --> Tests["Unit tests"]
    CI --> Build["Build"]

    Lint --> Gate{"CI conclusion?"}
    Tests --> Gate
    Build --> Gate

    Gate -->|"failed / cancelled"| NoDeploy["no deploy triggered"]
    Gate -->|"success (workflow_run)"| AutoDeploy["Backend deploy workflow (deploy-ec2.yml)<br/>build images -> roll out over SSH -> health-check"]
    Operator["Authorized operator"] -.->|"workflow_dispatch (optional, on-demand)"| AutoDeploy

    AutoDeploy --> Prod["Production (api.oraone.in)"]
